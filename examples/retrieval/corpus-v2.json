  "entries": [
    {"key": "zertifikat", "scope": "gamma", "status": "validated", "problem": "TLS-Zertifikat des Webservers ist abgelaufen", "solution": "Mit certbot renew erneuern und den Webserver neu laden"},
    {"key": "drucker", "scope": "global", "status": "validated", "problem": "Drucker im Büro druckt leere Seiten", "solution": "Druckkopf reinigen und Patrone tauschen"},
    {"key": "cronjob", "scope": "gamma", "status": "validated", "problem": "Nächtliche Sicherung per Cronjob läuft nicht", "solution": "Pfade in der crontab absolut angeben"},
    {"key": "passwort", "scope": "global", "status": "validated", "problem": "Passwort-Hash mit MD5 ist unsicher", "solution": "Argon2 oder bcrypt verwenden"},
    {"key": "index", "scope": "gamma", "status": "validated", "problem": "Abfrage auf großer Tabelle ist langsam, weil ein Index fehlt", "solution": "Index auf die Spalte der WHERE-Bedingung anlegen"},
    {"key": "speichermangel", "scope": "global", "status": "validated", "problem": "Container wird wegen Speichermangel vom Kernel beendet", "solution": "Speicherlimit erhöhen oder Verbrauch senken"},
    {"key": "endlosschleife", "scope": "gamma", "status": "validated", "problem": "Endlosschleife beim Einlesen der Warteschlange", "solution": "Abbruchbedingung prüfen"},
    {"key": "verbindung", "scope": "gamma", "status": "validated", "problem": "Datenbankverbindung bricht nach zehn Minuten Leerlauf ab", "solution": "Keepalive aktivieren oder Verbindungspool neu aufbauen"},
    {"key": "uebersetzung", "scope": "gamma", "status": "validated", "problem": "Übersetzung fehlt in der Benutzeroberfläche", "solution": "Schlüssel in die Sprachdatei eintragen"},
    {"key": "abhaengigkeit", "scope": "global", "status": "validated", "problem": "Zirkuläre Abhängigkeit zwischen zwei Modulen", "solution": "Gemeinsamen Teil in ein drittes Modul auslagern"},
    {"key": "rechnung", "scope": "gamma", "status": "validated", "problem": "Rechnung wird doppelt verschickt", "solution": "Versandstatus vor dem Senden prüfen"},
    {"key": "rechner", "scope": "global", "status": "validated", "problem": "Rechner bootet nach dem Update nicht mehr", "solution": "Im Bootmenü den älteren Kernel wählen"},
    {"key": "leser", "scope": "global", "status": "validated", "problem": "Feed-Leser zeigt keine neuen Artikel", "solution": "Feed-Adresse auf https umstellen"},
    {"key": "lesezeichen", "scope": "global", "status": "validated", "problem": "Lesezeichen gehen nach der Synchronisation verloren", "solution": "Synchronisation abschalten und Export einspielen"},
    {"key": "kostenstelle", "scope": "gamma", "status": "validated", "problem": "Kostenstelle fehlt in der Buchung", "solution": "Pflichtfeld im Buchungsformular setzen"},
    {"key": "cloud-kosten", "scope": "global", "status": "validated", "problem": "Kosten der Cloud steigen jeden Monat", "solution": "Ungenutzte Instanzen abschalten und Budgetwarnung einrichten"},
    {"key": "enoent", "scope": "gamma", "status": "validated", "problem": "Skript bricht ab: No such file or directory beim Öffnen der Logdatei", "solution": "Logordner vor dem Start anlegen"},
    {"key": "http-404", "scope": "gamma", "status": "validated", "problem": "HTTP 404 Not Found für die API-Route /health", "solution": "Route im Router registrieren"},
    {"key": "segfault", "scope": "global", "status": "validated", "problem": "Programm stürzt mit Segmentation fault (core dumped) ab", "solution": "Mit gdb den Backtrace prüfen"},
    {"key": "refused", "scope": "global", "status": "validated", "problem": "curl: Failed to connect: Connection refused auf localhost", "solution": "Prüfen, ob der Dienst läuft und auf dem Port lauscht"},
    {"key": "dienst-autostart", "scope": "gamma", "status": "validated", "problem": "Dienst startet nach dem Neustart des Servers nicht automatisch", "solution": "systemctl enable für den Dienst ausführen"},
    {"key": "mail-zustellung", "scope": "global", "status": "validated", "problem": "E-Mails kommen beim Empfänger nicht an", "solution": "SPF- und DKIM-Einträge prüfen"},
    {"key": "git-push", "scope": "global", "status": "validated", "problem": "Git-Push abgelehnt wegen non-fast-forward", "solution": "Zuerst git pull --rebase ausführen"},
    {"key": "pip-system", "scope": "global", "status": "validated", "problem": "pip meldet externally-managed-environment", "solution": "Virtuelle Umgebung mit python -m venv anlegen"},
    {"key": "video", "scope": "global", "status": "validated", "problem": "Video ruckelt im Browser bei Vollbild", "solution": "Hardwarebeschleunigung in den Browsereinstellungen aktivieren"},
    {"key": "vault-token", "scope": "delta", "status": "validated", "problem": "Vault-Token läuft im Staging nach einer Stunde ab", "solution": "Token-TTL in der Vault-Rolle erhöhen"},
    {"key": "pending-festplatte", "scope": "gamma", "status": "pending", "problem": "Backup-Skript bricht wegen voller Festplatte ab", "solution": "Alte Sicherungen rotieren"},
    {"key": "invalid-zeitzone", "scope": "gamma", "status": "invalidated", "problem": "Uhrzeit im Container ist falsch", "solution": "TZ=UTC fest setzen", "invalidation_reason": "Verdeckt die Ursache; Fixture für den Statusfilter"}
  ],
